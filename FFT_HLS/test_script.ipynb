from pynq import Overlay, MMIO
import numpy as np
import matplotlib.pyplot as plt

ol = Overlay("design_fft_hls.bit")
fft_ip = ol.fft_top1_0

# Exact addresses from mem_dict
BRAM_IN_ADDR  = 0xA0000000   # axi_bram_ctrl_0
BRAM_OUT_ADDR = 0xA0002000   # axi_bram_ctrl_1

bram_in  = MMIO(BRAM_IN_ADDR,  8192)
bram_out = MMIO(BRAM_OUT_ADDR, 8192)

N = 64

def float_to_fixed(val):
    return int(np.int32(val * (1 << 30)).view(np.uint32))

def fixed_to_float(bits):
    return float(np.int32(bits)) / (1 << 30)

# ---- Write input: cosine at bin 4 ----
print("Writing input to BRAM...")
for i in range(N):
    real = np.cos(2 * np.pi * 4 * i / N) * 0.4
    bram_in.write(i*8 + 0, float_to_fixed(real))
    bram_in.write(i*8 + 4, float_to_fixed(0.0))

# Verify write
print(f"Sample[0] re = {fixed_to_float(bram_in.read(0)):.4f}")
print(f"Sample[0] im = {fixed_to_float(bram_in.read(4)):.4f}")

# ---- Set FFT pointer registers (64-bit addr split into 2x32) ----
fft_ip.register_map.in_r_1  = BRAM_IN_ADDR  & 0xFFFFFFFF
fft_ip.register_map.in_r_2  = (BRAM_IN_ADDR  >> 32) & 0xFFFFFFFF
fft_ip.register_map.out_r_1 = BRAM_OUT_ADDR & 0xFFFFFFFF
fft_ip.register_map.out_r_2 = (BRAM_OUT_ADDR >> 32) & 0xFFFFFFFF

# ---- Set direction ----
fft_ip.register_map.direction = 1   # forward FFT

# ---- Start FFT ----
print("Starting FFT...")
fft_ip.register_map.CTRL.AP_START = 1

# ---- Poll done ----
for _ in range(1000000):
    if fft_ip.register_map.CTRL.AP_DONE == 1:
        break
print("FFT Done!")
print(f"Overflow: {fft_ip.register_map.ovflo}")

# ---- Read output ----
mags = []
for k in range(N):
    re = fixed_to_float(bram_out.read(k*8 + 0))
    im = fixed_to_float(bram_out.read(k*8 + 4))
    mags.append(np.sqrt(re**2 + im**2))

# ---- Plot ----
plt.figure(figsize=(12, 4))
plt.stem(mags)
plt.title("FFT Magnitude Spectrum")
plt.xlabel("Bin")
plt.ylabel("Magnitude")
plt.grid(True)
plt.show()

peak = np.argmax(mags)
print(f"Peak bin: {peak}, magnitude: {mags[peak]:.4f}")
if peak == 4 or peak == 60:
    print("PASS: FFT working correctly on hardware!")
else:
    print(f"FAIL: Unexpected peak at bin {peak}")
